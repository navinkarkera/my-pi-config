#!/usr/bin/env bash
set -euo pipefail

# Thin shell wrapper — resolves helper path and delegates to TS/JS helper.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HELPER="$SCRIPT_DIR/../git/mind-worker-rebuild/mind-worker-launcher.mjs"

if [ ! -f "$HELPER" ]; then
	echo "ERROR: helper not found at $HELPER" >&2
	exit 1
fi

exec node "$HELPER" "$@"
