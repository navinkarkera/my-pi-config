#!/usr/bin/env bash
set -euo pipefail

# Thin shell wrapper — dispatches to herdr launcher when terminalBackend == "herdr",
# otherwise falls back to the default node (kitty) launcher.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT_DIR="$SCRIPT_DIR/.."
CONFIG_FILE="$AGENT_DIR/mind-worker.json"
NODE_CMD=(mise x node@26 -- node)

# Parse --background flag (consumed here, not passed to launcher)
BACKGROUND_FLAG=0
PASSTHROUGH_ARGS=()
for arg in "$@"; do
  if [ "$arg" = "--background" ]; then
    BACKGROUND_FLAG=1
  else
    PASSTHROUGH_ARGS+=("$arg")
  fi
done
set -- "${PASSTHROUGH_ARGS[@]}"

# Also check env var
if [ "${MIND_WORKER_LAUNCHER_BACKGROUND:-}" = "1" ]; then
  BACKGROUND_FLAG=1
fi

# Check for herdr backend config
BACKEND=""
if [ -f "$CONFIG_FILE" ]; then
	BACKEND="$("${NODE_CMD[@]}" -e 'try{console.log(JSON.parse(require("fs").readFileSync(process.argv[1],"utf-8")).terminalBackend||"")}catch{console.log("")}' "$CONFIG_FILE" 2>/dev/null)"
fi

if [ "$BACKEND" = "herdr" ]; then
	HERDR_LAUNCHER="$AGENT_DIR/lib/mind-worker/herdr-launcher.mjs"
	if [ -f "$HERDR_LAUNCHER" ]; then
		if [ "$BACKGROUND_FLAG" = "1" ]; then
			LOG_FILE="$AGENT_DIR/mindworker/herdr-launcher-background.log"
			mkdir -p "$(dirname "$LOG_FILE")"
			MIND_WORKER_HERDR_BACKGROUND=1 nohup "${NODE_CMD[@]}" "$HERDR_LAUNCHER" "$@" < /dev/null >> "$LOG_FILE" 2>&1 &
			BG_PID=$!
			disown "$BG_PID" || true
			echo "Background mind-worker launcher started (PID: $BG_PID)" >&2
			exit 0
		fi
		exec "${NODE_CMD[@]}" "$HERDR_LAUNCHER" "$@"
	else
		echo "ERROR: herdr launcher not found at $HERDR_LAUNCHER" >&2
		exit 1
	fi
fi

# Default: delegate to existing node (kitty) launcher
HELPER="$SCRIPT_DIR/../lib/mind-worker/mind-worker-launcher.mjs"

if [ ! -f "$HELPER" ]; then
	echo "ERROR: helper not found at $HELPER" >&2
	exit 1
fi

exec "${NODE_CMD[@]}" "$HELPER" "$@"
