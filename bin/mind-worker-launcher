#!/usr/bin/env bash
set -euo pipefail

# Entrypoint for the mind + worker pair. The legacy hc/tmux hosting is retired,
# so this file is only a compatibility shim: it starts, stops, deletes and
# kills nothing itself and owns no record, pane or lock. A pool's lifetime
# belongs to mindmux, which decides by the invoking pane's session/server tuple.
#
#   mind-worker-launcher            exec mindmux start
#   mind-worker-launcher --force    exec mindmux start --force
#
# MINDMUX_BIN overrides PATH. Herdr's pi-current-mind and the Herdr app program
# run this path with no arguments and require it to be executable.
# Never legacy hosting: every old flag is refused instead of reinterpreted.

usage() {
    printf 'usage: mind-worker-launcher [--force]   start or focus Mind via mindmux\n' >&2
}
die() { printf 'mind-worker-launcher: %s\n' "$1" >&2; exit "${2:-1}"; }

# The binary to delegate to: an explicit override, else PATH. Empty = unavailable.
mindmux_bin() {
    local bin="${MINDMUX_BIN:-}"
    if [ -z "${bin}" ]; then bin="$(command -v mindmux 2>/dev/null || true)"; fi
    printf '%s' "${bin}"
}

FORCE=""
case "$#" in
    0) ;;
    1)
        case "$1" in
            --force) FORCE=force ;;
            -h|--help) usage; exit 0 ;;
            --*)
                printf 'mind-worker-launcher: %s is gone: the legacy hc/tmux host is retired; run mindmux start\n' "$1" >&2
                usage
                exit 2
                ;;
            *)
                printf 'mind-worker-launcher: %s is gone: session arguments are no longer accepted; run mindmux start in that pane\n' "$1" >&2
                usage
                exit 2
                ;;
        esac
        ;;
    *)
        printf 'mind-worker-launcher: arguments are gone (%s): run mindmux start in that pane\n' "$1" >&2
        usage
        exit 2
        ;;
esac

if [ -n "${MIND_WORKER_LAUNCHER_BACKGROUND:-}" ]; then
    die "MIND_WORKER_LAUNCHER_BACKGROUND is gone: Mind runs in the invoking terminal." 2
fi

BIN="$(mindmux_bin)"
[ -n "${BIN}" ] || die "mindmux is not installed: build it from ~/work/mindmux and put it on PATH"
[ -x "${BIN}" ] || die "mindmux is not executable: ${BIN}"

# exec keeps this PID: mindmux becomes the terminal's/pane's root program.
if [ -n "${FORCE}" ]; then
    exec "${BIN}" start --force
fi
exec "${BIN}" start
